+static void write_wav_header_stream(FILE * f, int32_t rate) {
+    const uint32_t max    = 0xFFFFFFFFu;
+    const uint32_t fmt_sz = 16, byte_rate = (uint32_t) rate * 2, rate32 = (uint32_t) rate;
+    const uint16_t fmt = 1, ch = 1, align = 2, bits = 16;
+    auto w = [&](const void * p, size_t n) { fwrite(p, 1, n, f); };
+    w("RIFF", 4); w(&max, 4); w("WAVE", 4);
+    w("fmt ", 4); w(&fmt_sz, 4);
+    w(&fmt, 2); w(&ch, 2); w(&rate32, 4);
+    w(&byte_rate, 4); w(&align, 2); w(&bits, 2);
+    w("data", 4); w(&max, 4);
