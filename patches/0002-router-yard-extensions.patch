+//
+// yard router extensions (patches/0002)
+//
+
+// preset-declared footprint for this configuration, in bytes, or 0 (no claim).
+// NOT a guess: it is a measurement somebody took on this card and wrote down.
+// It seeds the admission check only while the measure-child path has not
+// produced a real number (SERVER_MODEL_MEMORY_UNMEASURED / FAILED).
+static int64_t declared_footprint_bytes(const server_model_meta & meta) {
+    std::string value;
+    if (!meta.preset.get_option(COMMON_ARG_PRESET_VRAM_FOOTPRINT_MIB, value)) {
+        return 0;
+    }
+    try {
+        const int64_t mib = std::stoll(value);
+        return mib > 0 ? mib * 1024 * 1024 : 0;
+    } catch (const std::exception &) {
+        SRV_WRN("ignoring unparseable vram-footprint-mib for model=%s: '%s\n", meta.name.c_str(), value.c_str());
+        return 0;
+    }
+}
+
+// operator-declared VRAM freed per expert layer moved to system RAM, MiB, or 0.
+static int64_t shed_mib_per_layer(const server_model_meta & meta) {
+    std::string value;
+    if (!meta.preset.get_option(COMMON_ARG_PRESET_VRAM_SHED_MIB_PER_LAYER, value)) {
+        return 0;
+    }
+    try {
+        const int64_t mib = std::stoll(value);
+        return mib > 0 ? mib : 0;
+    } catch (const std::exception &) {
+        SRV_WRN("ignoring unparseable vram-shed-mib-per-layer for model=%s: '%s\n", meta.name.c_str(), value.c_str());
+        return 0;
+    }
+}
+
+static int current_n_cpu_moe(const server_model_meta & meta) {
+    std::string value;
+    if (!meta.preset.get_option("LLAMA_ARG_N_CPU_MOE", value)) {
+        return 0;
+    }
+    try {
+        const int n = std::stoi(value);
+        return n > 0 ? n : 0;
+    } catch (const std::exception &) {
+        return 0;
+    }
+}
+
+// pin is a PREFERENCE here, not a veto: a pinned model is skipped while any
+// unpinned victim exists, and only chosen when nothing else is left. An
+// absolute pin would make a big model permanently unloadable the moment
+// enough support models are pinned.
+static bool meta_is_pinned(const server_model_meta & meta) {
+    std::string value;
+    return meta.preset.get_option(COMMON_ARG_PRESET_PIN, value)
+        && (value == "1" || value == "true" || value == "yes" || value == "on");
+}
