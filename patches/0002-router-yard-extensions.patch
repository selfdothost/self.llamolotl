+// yard (patches/0002): push more expert layers to system RAM so a queued model
+// that cannot fit, fits. The lever is --n-cpu-moe, applied strictly at LOAD
+// time, so this rewrites the preset of a model that is about to (re)spawn --
+// cheap orchestration, no tensor surgery. Sizing is operator-declared
+// (vram-shed-mib-per-layer): anchored on a measured point, only has to get over
+// a threshold the child then re-checks for itself, so an optimistic figure
+// cannot turn a wait into silent corruption. Returns true when the config was
+// rewritten and the next admission pass should be attempted.
+bool server_models_sched::try_shed_to_fit(std::unique_lock<std::mutex> & lk, const std::string & name) {
+    check_lock(lk);
+    auto it = models.mapping.find(name);
+    if (it == models.mapping.end() || it->second.meta.is_running()) {
+        return false; // only a not-yet-spawned model can be reshaped here
+    }
+    server_model_meta & meta = it->second.meta;
+
+    const int64_t per_layer_mib = shed_mib_per_layer(meta);
+    if (per_layer_mib <= 0) {
+        return false; // no claim -> keep waiting, exactly as before
+    }
+    const auto missing = deficit(name);
+    if (missing.empty()) {
+        return false; // not the shortfall case
+    }
+    int64_t deficit_bytes = 0;
+    for (const auto & [dev, bytes] : missing) {
+        (void) dev;
+        deficit_bytes += (int64_t) bytes;
+    }
+    const int64_t per_layer_bytes = per_layer_mib * 1024 * 1024;
+    // round UP: shedding half a layer is not a thing; landing one layer heavy
+    // is an OOM while landing one light is only slower
+    const int64_t extra_layers = (deficit_bytes + per_layer_bytes - 1) / per_layer_bytes;
+    const int64_t shed_bytes   = extra_layers * per_layer_bytes;
+
+    // the declaration must move with the config it describes; if shedding
+    // would take the declared footprint to zero the linear model has been
+    // extrapolated past where it means anything -- keep waiting instead
+    const int64_t declared = declared_footprint_bytes(meta);
+    if (declared > 0 && declared - shed_bytes <= 0) {
+        SRV_INF("vram shed: model name=%s needs %lld more expert layer(s) on CPU than its declared "
+                "footprint can account for; not shedding\n", name.c_str(), (long long) extra_layers);
+        return false;
+    }
+
+    const int new_ncmoe = current_n_cpu_moe(meta) + (int) extra_layers;
+    SRV_INF("vram shed: model name=%s is short by %lld MiB; moving %lld expert layer(s) to system RAM "
+            "(-ncmoe -> %d, %lld MiB/layer). SLOWER BUT SERVING\n",
+            name.c_str(), (long long) (deficit_bytes / (1024 * 1024)),
+            (long long) extra_layers, new_ncmoe, (long long) per_layer_mib);
+
+    meta.preset.set_option(models.ctx_preset, "LLAMA_ARG_N_CPU_MOE", std::to_string(new_ncmoe));
+    if (declared > 0) {
+        meta.preset.set_option(models.ctx_preset, COMMON_ARG_PRESET_VRAM_FOOTPRINT_MIB,
+                               std::to_string((declared - shed_bytes) / (1024 * 1024)));
+    }
+    // re-render argv so the child actually spawns with the shed setting;
+    // without this the preset says one thing and the process another
+    meta.update_args(models.ctx_preset, models.bin_path);
+    return true;
+}
